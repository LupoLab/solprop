"""Typed boundary for the private nanobind extension."""

from collections.abc import Mapping, Sequence

import numpy as np
from jaxtyping import Complex, Float

type Real = Float[np.ndarray, "..."]
type Spectrum = Complex[np.ndarray, "..."]

class BeamState:
    def __init__(self, config: Mapping[str, object]) -> None: ...
    def load(self, field: Spectrum) -> None: ...
    def field(self) -> Spectrum: ...
    def evaluate(self, density: float) -> Spectrum: ...
    def step(self, dz: float, key: float, densities: Real) -> float: ...
    def finish(self, dz: float) -> None: ...
    def statistics(self, factor: float) -> Real: ...
    @property
    def timings(self) -> list[float]: ...
    @property
    def evaluations(self) -> int: ...
    @property
    def memory_bytes(self) -> int: ...
    @property
    def threads(self) -> int: ...
    @property
    def fft_schedule(self) -> str: ...
    @property
    def planning_seconds(self) -> float: ...

class State:
    def __init__(self, config: Mapping[str, object]) -> None: ...
    def load(self, field: Spectrum) -> None: ...
    def field(self) -> Spectrum: ...
    def _temporal(self) -> Real: ...
    def _roundtrip(self) -> Spectrum: ...
    def _response(self, field: Real, stage: Mapping[str, object]) -> Real: ...
    def evaluate(self, stage: Mapping[str, object]) -> Spectrum: ...
    def trial(
        self, dz: float, stages: Sequence[Mapping[str, object]], whole: Real
    ) -> tuple[float, float, float]: ...
    def accept(self, dz: float) -> None: ...
    def clear_fsal(self) -> None: ...
    def adams_start(self, stage: Mapping[str, object], rate: Real) -> None: ...
    def adams_trial(
        self,
        dz: float,
        step: Mapping[str, object],
        sample: Mapping[str, object],
        tables: Mapping[str, object],
    ) -> Real: ...
    def adams_accept(self, dz: float, slot: int, rate: Real) -> None: ...
    def history(self, name: str) -> Spectrum: ...
    def load_history(self, name: str, values: Spectrum) -> None: ...
    def populations(self, stage: Mapping[str, object]) -> Real: ...
    def diagnostics(self) -> list[float]: ...
    def statistics(self, weight: Real, axis: Real, factor: float) -> Real: ...
    def spatial_statistics(self, factor: float) -> Real: ...
    def reset_quadrature(self) -> None: ...
    @property
    def timings(self) -> list[float]: ...
    @property
    def response_timings(self) -> list[float]: ...
    @property
    def contraction(self) -> str: ...
    @property
    def evaluations(self) -> int: ...
    @property
    def quadrature(self) -> float: ...
    @property
    def memory_bytes(self) -> int: ...
    @property
    def threads(self) -> int: ...
    @property
    def planning_seconds(self) -> float: ...

def build_info() -> dict[str, object]: ...
def basis_rows(
    points: Real, upper: float, integrate: bool, rows: Real, weights: Real
) -> None: ...
def clenshaw_points(
    z: Real,
    edges: Real,
    lower: float,
    upper: float,
    coefficients: Real | Spectrum,
    out: Real | Spectrum,
) -> int: ...
