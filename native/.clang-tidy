# Whole check families. The exclusions, one reason each:
# - bugprone-easily-swappable-parameters: numerical kernels take runs of same-typed
#   extents and scalars by design.
# - performance-enum-size: the enums are few and small; a narrower base type gains
#   nothing.
# - modernize-use-trailing-return-type: style only; the code uses leading return types.
# - modernize-avoid-c-arrays: small fixed arrays are the idiom in device code.
# - misc-non-private-member-variables-in-classes: plain aggregates (Problem, plans,
#   records) are the seam's data.
# - misc-include-cleaner: too noisy across Kokkos's umbrella headers to gate; it runs
#   as a weekly report (.github/workflows/native-deep.yml).
# - misc-no-recursion: recursion is a design choice in host code, not a defect.
# - readability-magic-numbers: the numerical constants are cited where they appear.
# - readability-identifier-length: short names follow the mathematics (dz, n, k).
# - readability-math-missing-parentheses: precedence in arithmetic is not ambiguous.
# - readability-uppercase-literal-suffix: style only.
# - readability-trailing-comma: style only, and clang-format owns layout.
# - readability-braces-around-statements: the LLVM convention leaves single
#   statements unbraced, and adding braces around bodies with #if is unsafe.
# - readability-function-size, readability-function-cognitive-complexity: the long
#   setup functions and hot kernels are split first (a later change), then gated.
# - readability-avoid-nested-conditional-operator: nested conditionals initialise
#   const locals, in kernels too; an immediately invoked lambda reads worse.
# - readability-make-member-function-const: Kokkos views are handles, so a member
#   that writes through one would be marked const although it changes the state.
# - clang-analyzer-osx.*: Apple framework checks; the code calls no Objective-C or
#   Core Foundation API.
# - clang-analyzer-optin.performance.Padding: the cold configuration structs are
#   ordered by concern, not by size.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  -performance-enum-size,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-no-recursion,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-math-missing-parentheses,
  -readability-uppercase-literal-suffix,
  -readability-trailing-comma,
  -readability-braces-around-statements,
  -readability-function-size,
  -readability-function-cognitive-complexity,
  -readability-avoid-nested-conditional-operator,
  -readability-make-member-function-const,
  cppcoreguidelines-special-member-functions,
  clang-analyzer-*,
  -clang-analyzer-osx.*,
  -clang-analyzer-optin.performance.Padding,
  portability-restrict-system-includes,
  portability-simd-intrinsics
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include|src)/.*'
FormatStyle: file
CheckOptions:
  # `.value()` is a checked access: it throws std::bad_optional_access.
  bugprone-unchecked-optional-access.IgnoreValueCalls: true
  # A cast to void is an explicit discard (unique_ptr::release once a capsule owns it).
  bugprone-unused-return-value.AllowCastToVoid: true
  # A shift or mask by a positive literal (`std::size_t{64} << 20`) is not a sign bug.
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
