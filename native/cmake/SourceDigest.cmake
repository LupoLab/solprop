# The digest of what the extension is compiled from, which `check_build()` compares with
# an editable checkout's sources (`solprop_native._source_digest` computes it in Python:
# keep the two in step). The record is one "{path}:{sha256 of its bytes}\n" for
# CMakeLists.txt and each file these patterns match, the paths relative to native/ and
# sorted bytewise; the digest is the SHA-256 of the record.
#
# CMakeLists.txt includes this file for the patterns. A custom command runs it as a script
# to write the translation unit that holds the digest, so an edit recompiles that one file
# and neither reconfigures nor touches a heavy one:
#
#   cmake -DSOURCE_ROOT=<native> -DOUTPUT=<file.cpp> -P SourceDigest.cmake
set(SOLPROP_NATIVE_DIGEST_GLOBS
    src/*.cpp src/*.hpp src/*.h include/*.cpp include/*.hpp include/*.h)
if(NOT CMAKE_SCRIPT_MODE_FILE)
  return()
endif()
cmake_policy(VERSION 3.23...4.4)

list(TRANSFORM SOLPROP_NATIVE_DIGEST_GLOBS PREPEND "${SOURCE_ROOT}/" OUTPUT_VARIABLE globs)
file(GLOB_RECURSE sources RELATIVE "${SOURCE_ROOT}" ${globs})
list(APPEND sources CMakeLists.txt)
list(SORT sources COMPARE STRING CASE SENSITIVE)
set(record "")
foreach(source IN LISTS sources)
  file(SHA256 "${SOURCE_ROOT}/${source}" hash)
  string(APPEND record "${source}:${hash}\n")
endforeach()
string(SHA256 digest "${record}")
# Written only when it changes, so a touched file recompiles nothing.
file(CONFIGURE OUTPUT "${OUTPUT}" @ONLY CONTENT
"// Generated by cmake/SourceDigest.cmake: the digest of what the extension is compiled from.
namespace solprop_native {
const char* source_digest() noexcept { return \"@digest@\"; }
} // namespace solprop_native
")
