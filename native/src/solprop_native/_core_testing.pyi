# solprop SEP 52 section 6.5: native's engines through solprop's protocols
# (`solprop.backends.engines`), each method prefixed by its engine, with read-backs.
class Engines:
    def __init__(self) -> None: ...  # made by `engines(workspace)` alone
    def field(self) -> npt.NDArray[np.complex128]: ...
    def stage(self, index: int) -> npt.NDArray[np.complex128]: ...
    def load(
        self, field: npt.NDArray[np.complex128], noise: npt.NDArray[np.complex128]
    ) -> None: ...
    def close(self) -> None: ...
    def rk_trial(self, z: float, dz: float) -> float: ...
    def rk_accept(self, dz: float) -> Any: ...
    def rk_extend(self, z: float, dz: float) -> None: ...
    def rk_reading(self) -> Any: ...
    @property
    def rk_in_flight(self) -> bool: ...
    def adams_start(self, z: float) -> None: ...
    def adams_trial(
        self, z: float, dz: float, stencil: Any
    ) -> npt.NDArray[np.float64]: ...
    def adams_accept(
        self, dz: float, free: int, stencil: Any, kept: Sequence[Any]
    ) -> Any: ...
    def adams_chord_phase(self, z1: float, z2: float) -> float: ...
    def adams_step_carrier(
        self, order: int
    ) -> npt.NDArray[np.float64] | list[float]: ...
    def adams_begin_attempt(self, cost: int) -> None: ...
    def adams_end_attempt(self, outcome: int) -> None: ...
    def adams_reading(self) -> Any: ...

def engines(workspace: Workspace) -> Engines: ...
def inject_fault(
